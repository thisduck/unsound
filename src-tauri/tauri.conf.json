{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unsound",
  "version": "0.9.1",
  "identifier": "com.unsound.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "unsound",
        "width": 1060,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4NTQyQTZFMzI1QjMzMwpSV1F6c3lYanBrS0ZCcVA5NWdDV3FpWXpkR1ZLalJkMzVTcmNGMjYrdzhTalc5ekJGcWxuSFducAo=",
      "endpoints": [
        "https://github.com/thisduck/unsound/releases/latest/download/latest.json"
      ]
    }
  }
}
