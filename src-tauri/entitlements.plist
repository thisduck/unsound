<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime apps must declare mic access or recording is denied. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- ...and calendar access, for titling meetings from the current event. -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
  <!-- Hardened runtime blocks Apple Events unless declared: Mail drafts and
       Reminders items for the meeting assistant. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
