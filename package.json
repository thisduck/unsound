{
  "name": "tauri-app",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:reliability": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib reliability",
    "e2e:build": "node e2e/build.mjs",
    "e2e:check": "node e2e/preflight.mjs",
    "test:e2e": "npm run e2e:check && wdio run e2e/wdio.conf.mjs",
    "test:notes": "node --test tests/*.test.mjs",
    "test:native-backend": "node e2e/native-backend.mjs",
    "bench:meeting": "node e2e/meeting-bench.mjs",
    "test:meeting-quality": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib notes_quality && cargo test --locked --manifest-path src-tauri/Cargo.toml --lib speakers::tests && cargo test --locked --manifest-path src-tauri/Cargo.toml --lib summary::tests::names && cargo test --locked --manifest-path src-tauri/Cargo.toml --lib meeting_metrics"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crabnebula/tauri-driver": "^2.0.9",
    "@crabnebula/test-runner-backend": "^0.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "webdriverio": "^10.0.2"
  }
}
